RewriteEngine On
RewriteBase /report-dpk/api/

# Jangan sajikan dotfile API sebagai file statis.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,END,NC]
# Folder source hanya boleh dipanggil melalui api/index.php.
RewriteRule ^(?:controllers|helpers|middlewares|routes)(?:/|$) - [F,END,NC]

# RewriteBase /api/

# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^([^/]+)/?$ index.php?request=$1 [L,QSA]

# RewriteEngine On

# Jika file/folder tidak ada, teruskan ke index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?request=$1 [QSA,L]



