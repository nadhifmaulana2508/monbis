# Salin file ini menjadi api/.env. Seluruh konfigurasi runtime PHP disimpan di sana.

# Database DPK
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=
DB_PORT=3306
DB_ROOT=3306

# Database Prospek
DB_HOST1=127.0.0.1
DB_USER1=root
DB_PASS1=
DB_NAME1=
DB_PORT1=3306

# Database SIMPEG
SIMPEG_DB_HOST=127.0.0.1
SIMPEG_DB_USER=root
SIMPEG_DB_PASS=
SIMPEG_DB_NAME=
SIMPEG_DB_PORT=3306

# URL API SSO bersama
SSO_API_BASE=https://apisso.bkkjateng.co.id
# Kredensial aplikasi server-side untuk API SSO. Jangan gunakan prefix VITE_;
# token ini tidak boleh dikirim ke browser.
SSO_APP_CODE=monbis
SSO_APP_TOKEN=
# Opsional: paksa koneksi PHP ke alamat internal SSO jika IP publik server tidak bisa diakses dari server itu sendiri.
# Isi 127.0.0.1 jika SSO berbagi server dan virtual host SSO dapat diakses melalui loopback; kosongkan selain itu.
SSO_API_CONNECT_IP=

# URL aplikasi aktif berdasarkan host yang diakses.
APP_URL_LOCAL=http://localhost/report-dpk
APP_URL_DEV=https://dev.monbis.bkkjateng.co.id
APP_URL_PROD=https://monbis.bkkjateng.co.id

# Opsional: daftar origin lintas domain yang diizinkan, pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=http://localhost

# Opsional: konfigurasi provider AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
